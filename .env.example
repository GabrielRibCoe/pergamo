# Copie este arquivo para .env e preencha. O .env NÃO vai para o GitHub.
# memory = banco em memória (padrão) | sqlite = offline | mongo = online
PERGAMO_DB=memory
PERGAMO_SQLITE_PATH=data/pergamo_local.db
# Peça a URI ao responsável pelo MongoDB (papel 1). Nunca coloque a URI no código.
PERGAMO_MONGO_URI=
PERGAMO_MONGO_DB=pergamo
